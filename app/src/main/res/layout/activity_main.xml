<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:animateLayoutChanges="true"
    tools:context=".MainActivity">

    <!-- HEADER : Barre de recherche et actions rapides -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/white"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/search_bar"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/rounded_background"
            android:backgroundTint="#F0F0F0"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:text="Search PROLO, BTC, ETH..."
            android:textColor="#888888"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ic_scan"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ic_scan"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="#333333"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ic_msg"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ic_msg"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@android:drawable/ic_dialog_email"
            app:tint="#333333"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Petit badge rouge de notification sur les messages -->
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="-2dp"
            android:layout_marginEnd="-2dp"
            android:background="@drawable/btn_rounded_corners"
            android:backgroundTint="#FF3B30"
            app:layout_constraintEnd_toEndOf="@id/ic_msg"
            app:layout_constraintTop_toTopOf="@id/ic_msg" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- LE CONTENU CENTRAL (Scrollable à l'infini) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_action_bar"
        app:layout_constraintTop_toBottomOf="@id/header_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:animateLayoutChanges="true">

            <!-- BANNIERE PRINCIPALE -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_margin="12dp"
                android:background="@drawable/rounded_background"
                android:backgroundTint="#FF3B30">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:text="🔥 NEW USER BONUS"
                    android:textColor="#FFD700"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_bonus_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="36dp"
                    android:text="GET 10,000 PROLO\n+ MYSTERY BOX!"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="16dp"
                    android:backgroundTint="#FFD700"
                    android:text="CLAIM NOW >"
                    android:textColor="#FF3B30"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/prolovest_white"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- GRILLE DE NAVIGATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="💳\nBuy" android:textAlignment="center" android:textColor="#333333" android:textSize="18sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🔄\nP2P" android:textAlignment="center" android:textColor="#333333" android:textSize="18sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="📈\nEarn" android:textAlignment="center" android:textColor="#333333" android:textSize="18sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🎁\nRewards" android:textAlignment="center" android:textColor="#333333" android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:weightSum="4">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🤖\nAI Bot" android:textAlignment="center" android:textColor="#333333" android:textSize="18sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🏦\nCards" android:textAlignment="center" android:textColor="#333333" android:textSize="18sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🎮\nGames" android:textAlignment="center" android:textColor="#333333" android:textSize="18sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="⭐\nMore" android:textAlignment="center" android:textColor="#333333" android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ANNONCE DEFILANTE (Marquee animé) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_margin="12dp"
                android:background="@drawable/rounded_background"
                android:backgroundTint="#E8E8E8"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📢 "
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="User 18**39 just claimed 50 PROLO... 🔥 ETH is up 5% today! 🔥 Stake your tokens to earn massive rewards..."
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />
            </LinearLayout>

            <!-- FLASH SALE / MARCHÉ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:text="⚡ Hot Tokens"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="@drawable/rounded_background"
                android:backgroundTint="@color/white"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- PROLO -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PRO" android:textStyle="bold" android:textSize="16sp" android:textColor="#333333"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$1.24" android:textSize="16sp" android:textStyle="bold" android:textColor="#333333"/>
                    <TextView android:layout_width="70dp" android:layout_height="28dp" android:layout_marginStart="12dp" android:background="@drawable/btn_rounded_corners" android:backgroundTint="#E8F5E9" android:gravity="center" android:text="+142%" android:textColor="#4CAF50" android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>

                <!-- BTC -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="BTC" android:textStyle="bold" android:textSize="16sp" android:textColor="#333333"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$64,320" android:textSize="16sp" android:textStyle="bold" android:textColor="#333333"/>
                    <TextView android:layout_width="70dp" android:layout_height="28dp" android:layout_marginStart="12dp" android:background="@drawable/btn_rounded_corners" android:backgroundTint="#E8F5E9" android:gravity="center" android:text="+2.4%" android:textColor="#4CAF50" android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>

                <!-- ETH -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ETH" android:textStyle="bold" android:textSize="16sp" android:textColor="#333333"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$3,450" android:textSize="16sp" android:textStyle="bold" android:textColor="#333333"/>
                    <TextView android:layout_width="70dp" android:layout_height="28dp" android:layout_marginStart="12dp" android:background="@drawable/btn_rounded_corners" android:backgroundTint="#E8F5E9" android:gravity="center" android:text="+5.1%" android:textColor="#4CAF50" android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>

                <!-- SOL -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SOL" android:textStyle="bold" android:textSize="16sp" android:textColor="#333333"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$145.20" android:textSize="16sp" android:textStyle="bold" android:textColor="#333333"/>
                    <TextView android:layout_width="70dp" android:layout_height="28dp" android:layout_marginStart="12dp" android:background="@drawable/btn_rounded_corners" android:backgroundTint="#E8F5E9" android:gravity="center" android:text="+12.3%" android:textColor="#4CAF50" android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>

                <!-- DOGE -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="DOGE" android:textStyle="bold" android:textSize="16sp" android:textColor="#333333"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$0.12" android:textSize="16sp" android:textStyle="bold" android:textColor="#333333"/>
                    <TextView android:layout_width="70dp" android:layout_height="28dp" android:layout_marginStart="12dp" android:background="@drawable/btn_rounded_corners" android:backgroundTint="#E8F5E9" android:gravity="center" android:text="+1.5%" android:textColor="#4CAF50" android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>

                <!-- CHIA (En négatif rouge) -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="XCH" android:textStyle="bold" android:textSize="16sp" android:textColor="#333333"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$30.50" android:textSize="16sp" android:textStyle="bold" android:textColor="#333333"/>
                    <TextView android:layout_width="70dp" android:layout_height="28dp" android:layout_marginStart="12dp" android:background="@drawable/btn_rounded_corners" android:backgroundTint="#FFEBEE" android:gravity="center" android:text="-0.8%" android:textColor="#F44336" android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- MINI PROGRAMMES / ECOSYSTEM (BUGS CORRIGES ICI) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:text="🌐 Prolovest Ecosystem"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Carte Assurance Auto -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="220dp"
                        android:layout_height="110dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="#1A252F"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tv_eco_auto_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚗 Prolo AutoCare"
                            android:textColor="@color/gold"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Insure your vehicle up to 200,000 km directly with crypto."
                            android:textColor="#CCCCCC"
                            android:textSize="12sp"
                            app:layout_constraintTop_toBottomOf="@id/tv_eco_auto_title"
                            app:layout_constraintStart_toStartOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Carte Sponsoring Sportif -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="220dp"
                        android:layout_height="110dp"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="#C3891C"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tv_eco_box_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🥊 Prolo Boxing Club"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Stake PROLO to sponsor the team and earn exclusive NFTs!"
                            android:textColor="#FFF4D4"
                            android:textSize="12sp"
                            app:layout_constraintTop_toBottomOf="@id/tv_eco_box_title"
                            app:layout_constraintStart_toStartOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BARRE DE NAVIGATION EN BAS -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_action_bar"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@color/white"
        android:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/sign_in"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#F0F0F0"
            android:onClick="goToSignIn"
            android:text="SIGN IN"
            android:textColor="#333333"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/sign_up"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/sign_up"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:backgroundTint="#C3891C"
            android:onClick="goToSignUp"
            android:text="SIGN UP NOW"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/sign_in"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>