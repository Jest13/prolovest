<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme sans Action Bar -->
    <style name="Theme.prolovest" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- 🔴 LA MAGIE EST ICI -->
        <!-- 1. On donne à la barre de l'heure la même couleur que le fond de ton appli -->
        <item name="android:statusBarColor" tools:targetApi="l">#F5F6FA</item>
        <!-- 2. On dit à Android que le fond est clair, pour qu'il mette l'heure et la batterie en gris foncé/noir -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>
</resources>